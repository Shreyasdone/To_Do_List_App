<%- include('includes/header.ejs') %>
<body>
    <h1>Edit Your Task</h1>
    <div class="d-flex align-items-center justify-content-center">
        <div class="mx-auto w-75">
          <form method="post" action="/tasks/<%=task._id%>?_method=PATCH">
            <div class="mb-3">
              <label for="title" class="form-label">Title</label>
              <input type="text" value="<%=task.title%>" class="form-control" name="title" id="title" aria-describedby="task title">
            </div>
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" name="description" id="description" rows="10" placeholder="Enter task Description"><%=task.description%></textarea>
            </div>
            <!-- <button class="btn secondary-bg">Add Task</button> -->
             <button class="btn btn-primary">Submit</button>
          </form>
        </div>
    </div>
</body>